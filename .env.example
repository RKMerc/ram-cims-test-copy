APP_NAME="RAM-CIMS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ram_cims
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="RAM-CIMS"

# Gmail SMTP. Laravel 12 uses MAIL_SCHEME, not MAIL_ENCRYPTION.
# MAIL_SCHEME=smtp is STARTTLS on port 587. MAIL_ENCRYPTION=tls is accepted as a fallback.
# MAIL_USERNAME and MAIL_FROM_ADDRESS are the authorized sending account.
# Do not put the clinic recipient's password here unless that account is the authorized sender.
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_SCHEME=smtp
# MAIL_ENCRYPTION=tls
# MAIL_USERNAME=authorized_sender@gmail.com
# MAIL_PASSWORD=
# MAIL_FROM_ADDRESS=authorized_sender@gmail.com
# MAIL_FROM_NAME="RAM-CIMS"
CLINIC_ALERT_EMAIL=anamaet@apc.edu.ph
CLINIC_ALERT_GREETING="Ms. Torre"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=

# Google Gemini is optional and server-side only. Leave the key empty to keep RAMsey on local rules.
# Do not put this key in frontend code. Do not enable it for live clinic chats until privacy approval is recorded.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT=8
GEMINI_RATE_LIMIT=12

VITE_APP_NAME="${APP_NAME}"
